# Copy to .env and fill in. Placeholders only; never commit real values.

# --- Core ---
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Omit for SQLite at BASE_DIR/db.sqlite3
# DATABASE_URL=postgres://user:password@localhost:5432/gymapp

# --- Email ---
# Omitted with DEBUG=True gives the console backend. Required when DEBUG=False.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Tokens ---
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Throttling (requests per minute, floor of 5 enforced) ---
THROTTLE_LOGIN_PER_MINUTE=10
THROTTLE_REGISTRATION_PER_MINUTE=5
THROTTLE_PASSWORD_RESET_PER_MINUTE=5

# --- CORS (comma separated; https required when DEBUG=False) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Razorpay ---
# KEY_ID is public. KEY_SECRET and WEBHOOK_SECRET must never reach a client.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me
RAZORPAY_ACCOUNT_CURRENCY=INR

# --- Billing ---
SAAS_TRIAL_DAYS=14
SAAS_INVOICE_LEAD_DAYS=7

# --- AI revenue recovery ---
# Omit RECOVERY_LLM_CLIENT and the agent uses its offline deterministic planner, so a
# batch runs with no API key and no network. Set it to the hosted planner to use a real
# model; the guardrails are identical either way, because they run in Python after the
# model has spoken.
#
#   pip install openai
#
# The planner speaks the OpenAI tool-calling API but is not tied to OpenAI. Point
# RECOVERY_LLM_BASE_URL at any provider implementing the same surface.
#
# OpenAI:
#   RECOVERY_LLM_CLIENT=core.services.recovery_agent.OpenAIToolCallingClient
#   RECOVERY_LLM_MODEL=gpt-4o-mini
#   OPENAI_API_KEY=replace-me
#
# Groq (free tier, no card, OpenAI-compatible; check its current model list):
#   RECOVERY_LLM_CLIENT=core.services.recovery_agent.OpenAIToolCallingClient
#   RECOVERY_LLM_BASE_URL=https://api.groq.com/openai/v1
#   RECOVERY_LLM_MODEL=llama-3.3-70b-versatile
#   OPENAI_API_KEY=replace-me
#
# Set RECOVERY_LLM_TOOL_CHOICE=auto if a provider rejects `required`.
# RECOVERY_LLM_CLIENT=
# RECOVERY_LLM_MODEL=gpt-4o-mini
# RECOVERY_LLM_BASE_URL=
# RECOVERY_LLM_TOOL_CHOICE=required
# OPENAI_API_KEY=replace-me
# Member-facing base for recovery payment links. Carries an order reference, never a secret.
# RECOVERY_CHECKOUT_BASE_URL=https://pay.gymapp.example/checkout
